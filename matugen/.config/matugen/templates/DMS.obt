@OBSThemeMeta {
    name: 'DMS';
    id: 'com.dms.matugen';
    extends: 'com.obsproject.Yami';
    author: 'matugen';
    dark: 'true';
}

@OBSThemeVars {
    /* OBS Color Palette -- replaced with dynamic material tokens */

    --blue1: {{ palettes.primary._90.hex }};
    --blue2: {{ palettes.primary._80.hex }};
    --blue3: {{ palettes.primary._60.hex }};
    --blue4: {{ palettes.primary._50.hex }};
    --blue5: {{ palettes.primary._40.hex }};
    --blue6: {{ palettes.primary._30.hex }};

    --red1: {{ palettes.error._90.hex }};
    --red2: {{ palettes.error._80.hex }};
    --red3: {{ palettes.error._60.hex }};
    --red4: {{ palettes.error._50.hex }};
    --red5: {{ palettes.error._40.hex }};
    --red6: {{ palettes.error._30.hex }};

    --pink1: {{ palettes.error._90.hex }};
    --pink2: {{ palettes.error._80.hex }};
    --pink3: {{ palettes.error._70.hex }};
    --pink4: {{ palettes.error._60.hex }};
    --pink5: {{ palettes.error._50.hex }};
    --pink6: {{ palettes.error._40.hex }};

    --teal1: {{ palettes.tertiary._90.hex }};
    --teal2: {{ palettes.tertiary._80.hex }};
    --teal3: {{ palettes.tertiary._60.hex }};
    --teal4: {{ palettes.tertiary._50.hex }};
    --teal5: {{ palettes.tertiary._40.hex }};
    --teal6: {{ palettes.tertiary._30.hex }};

    --purple1: {{ palettes.tertiary._90.hex }};
    --purple2: {{ palettes.tertiary._80.hex }};
    --purple3: {{ palettes.tertiary._70.hex }};
    --purple4: {{ palettes.tertiary._60.hex }};
    --purple5: {{ palettes.tertiary._50.hex }};
    --purple6: {{ palettes.tertiary._40.hex }};

    --green1: {{ palettes.primary._90.hex }};
    --green2: {{ palettes.primary._80.hex }};
    --green3: {{ palettes.primary._60.hex }};
    --green4: {{ palettes.primary._50.hex }};
    --green5: {{ palettes.primary._40.hex }};
    --green6: {{ palettes.primary._30.hex }};

    --yellow1: {{ palettes.tertiary._90.hex }};
    --yellow2: {{ palettes.tertiary._80.hex }};
    --yellow3: {{ palettes.tertiary._60.hex }};
    --yellow4: {{ palettes.tertiary._50.hex }};
    --yellow5: {{ palettes.tertiary._40.hex }};
    --yellow6: {{ palettes.tertiary._30.hex }};

    --grey1: {{ palettes.neutral._50.hex }};
    --grey2: {{ palettes.neutral._40.hex }};
    --grey3: {{ palettes.neutral._35.hex }};
    --grey4: {{ palettes.neutral._30.hex }};
    --grey5: {{ palettes.neutral._25.hex }};
    --grey6: {{ palettes.neutral._20.hex }};
    --grey7: {{ palettes.neutral._10.hex }};
    --grey8: {{ palettes.neutral._0.hex }};

    --white1: {{ palettes.neutral._100.hex }};
    --white2: {{ palettes.neutral._95.hex }};
    --white3: {{ palettes.neutral._90.hex }};
    --white4: {{ palettes.neutral._80.hex }};
    --white5: {{ palettes.neutral._70.hex }};

    --black1: {{ palettes.neutral._10.hex }};
    --black2: {{ palettes.neutral._20.hex }};
    --black3: {{ palettes.neutral._40.hex }};
    --black4: {{ palettes.neutral._60.hex }};
    --black5: {{ palettes.neutral._80.hex }};

    /* Base Theme Colors */
    --bg_window: var(--grey7);
    --bg_base: var(--grey6);
    --bg_preview: var(--grey8);

    --primary: var(--blue3);
    --primary_light: var(--blue2);
    --primary_lighter: var(--blue1);
    --primary_dark: var(--blue4);
    --primary_darker: var(--blue5);

    --warning: var(--yellow3);
    --danger: var(--red3);

    --text: var(--white1);
    --text_light: var(--white2);
    --text_muted: var(--white5);

    --text_disabled: var(--text_muted);
    --text_inactive: var(--white4);

    /* Qt Palette mapping */
    --palette_window: var(--bg_window);
    --palette_windowText: var(--text);
    --palette_base: var(--bg_base);

    --palette_light: var(--grey2);
    --palette_mid: var(--grey7);
    --palette_dark: var(--grey6);

    --palette_highlight: var(--primary);
    --palette_highlightedText: var(--white1);

    --palette_text: var(--text);
    --palette_link: var(--blue1);
    --palette_linkVisited: var(--blue1);

    --palette_button: var(--button_bg);
    --palette_buttonText: var(--text);

    --palette_text_active: var(--white1);
    --palette_text_inactive: var(--white4);
    --palette_text_disabled: var(--text_disabled);

    /* Inputs / Controls */
    --border_color: var(--grey4);

    --input_bg: var(--grey4);
    --input_bg_hover: var(--grey7);
    --input_bg_focus: var(--grey7);

    --list_item_bg_selected: var(--primary);
    --list_item_bg_hover: var(--primary_light);

    --input_border: var(--grey1);
    --input_border_hover: var(--grey1);
    --input_border_focus: var(--primary);

    --button_bg: var(--input_bg);
    --button_bg_hover: var(--grey3);
    --button_bg_down: var(--grey7);
    --button_bg_disabled: var(--grey6);

    --button_border: var(--button_bg);
    --button_border_hover: var(--grey1);
    --button_border_focus: var(--grey1);

    --tab_bg: var(--button_bg_disabled);
    --tab_bg_hover: var(--button_bg_hover);
    --tab_bg_down: var(--primary);
    --tab_bg_disabled: var(--button_bg_disabled);

    --tab_border: var(--border_color);
    --tab_border_hover: var(--button_border_hover);
    --tab_border_focus: var(--primary_lighter);
    --tab_border_selected: var(--primary);

    --scrollbar_handle: var(--grey4);
    --scrollbar_bg: var(--grey6);
    --scrollbar_hover: var(--grey3);
    --scrollbar_down: var(--grey2);
    --scrollbar_border: var(--grey2);

    --separator_hover: var(--white1);
    --highlight_color: var(--primary_lighter);
}
